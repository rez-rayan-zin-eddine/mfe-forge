{
  "name": "@mfe-forge/testing",
  "version": "0.0.0",
  "description": "Testing utilities for MFE Forge",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.tsx --format esm --dts --external react,@testing-library/react",
    "dev": "tsup src/index.tsx --format esm --dts --watch --external react,@testing-library/react",
    "type-check": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@testing-library/react": "^16.0.0",
    "react": "^19.0.0",
    "vitest": "^1.5.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/jsdom": "^21.1.7",
    "@types/react": "^19.0.0",
    "jsdom": "^24.0.0",
    "tsup": "^8.0.0",
    "typescript": "~5.8.3",
    "vitest": "^1.5.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://d-rayno.github.io/mfe-forge/",
  "repository": {
    "type": "git",
    "url": "https://github.com/D-Rayno/mfe-forge.git",
    "directory": "packages/testing"
  },
  "bugs": {
    "url": "https://github.com/D-Rayno/mfe-forge/issues"
  },
  "license": "MIT"
}
