{
  "name": "@mfe-forge/store",
  "version": "0.1.1",
  "description": "Shared state management for MFE Forge",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --external zustand",
    "dev": "tsup src/index.ts --format esm --dts --watch --external zustand",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "check:package": "publint --strict"
  },
  "peerDependencies": {
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "~5.8.3",
    "vitest": "^4.1.11",
    "zustand": "^5.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://rez-rayan-zin-eddine.github.io/mfe-forge/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rez-rayan-zin-eddine/mfe-forge.git",
    "directory": "packages/store"
  },
  "bugs": {
    "url": "https://github.com/rez-rayan-zin-eddine/mfe-forge/issues"
  },
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": ">=20.0.0"
  }
}
