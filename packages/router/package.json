{
  "name": "@mfe-forge/router",
  "version": "0.1.0",
  "description": "Routing coordination utilities for MFE Forge",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.tsx --format esm --dts --external react,react-dom,react-router-dom",
    "dev": "tsup src/index.tsx --format esm --dts --watch --external react,react-dom,react-router-dom",
    "type-check": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.0.0",
    "jsdom": "^24.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "tsup": "^8.0.0",
    "typescript": "~5.8.3",
    "vitest": "^1.5.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://rez-rayan-zin-eddine.github.io/mfe-forge/",
  "repository": {
    "type": "git",
    "url": "https://github.com/rez-rayan-zin-eddine/mfe-forge.git",
    "directory": "packages/router"
  },
  "bugs": {
    "url": "https://github.com/rez-rayan-zin-eddine/mfe-forge/issues"
  },
  "license": "MIT"
}
