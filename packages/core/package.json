{
  "name": "@mfe-forge/core",
  "version": "0.0.0",
  "description": "Core runtime utilities for MFE Forge applications",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./error-boundary": {
      "import": "./dist/error-boundary.js",
      "types": "./dist/error-boundary.d.ts"
    },
    "./event-bus": {
      "import": "./dist/event-bus.js",
      "types": "./dist/event-bus.d.ts"
    },
    "./loader": {
      "import": "./dist/loader.js",
      "types": "./dist/loader.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "type-check": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsup": "^8.0.0",
    "typescript": "~5.8.3",
    "vitest": "^1.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://d-rayno.github.io/mfe-forge/",
  "repository": {
    "type": "git",
    "url": "https://github.com/D-Rayno/mfe-forge.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/D-Rayno/mfe-forge/issues"
  },
  "license": "MIT"
}
